# ==============================================================================
# JARVIS Configuration File Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure your secrets locally.
# DO NOT put your real API keys or secrets in this file.

# 1. Claude AI Intelligence Layer (Anthropic API Key)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 2. Preferred Claude Model
# Options: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# 3. JARVIS Storage & Cache Directories (Locked to Drive D:)
OPENJARVIS_HOME=D:\JARVIS
UV_CACHE_DIR=D:\JARVIS\.cache\uv
PIP_CACHE_DIR=D:\JARVIS\.cache\pip
HF_HOME=D:\JARVIS\.cache\huggingface
OLLAMA_MODELS=D:\JARVIS\.cache\ollama
TEMP=D:\JARVIS\.cache\temp
TMP=D:\JARVIS\.cache\temp

# 4. Safety Guardrail Level
# Options: strict (asks permission for file changes/apps), standard
JARVIS_SECURITY_MODE=strict
